# Copy to .env if you use a tool that loads env files (Node does not load .env by itself).
# Or just set variables inline:  ADMIN_KEY=my-secret PORT=8080 npm start
PORT=3000
ADMIN_KEY=change-me          # needed for PATCH /api/orders/:id (dashboard "Admin mode")
CORS_ORIGIN=                 # e.g. https://your-name.github.io  (only if the front end is hosted elsewhere)
